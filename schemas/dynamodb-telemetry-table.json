      "CPUUtilization": { "N": "24.5" },
      "Status": { "S": "Healthy" },
      "ExpireAt": { "N": "1797638400" }
    },
    {
      "InstanceID": { "S": "i-web-01" },
      "Timestamp": { "S": "2026-11-19T10:05:00Z" },
      "CPUUtilization": { "N": "91.2" },
