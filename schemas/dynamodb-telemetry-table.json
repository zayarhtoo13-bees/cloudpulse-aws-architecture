{
  "TableName": "CloudPulse-Telemetry",
  "BillingMode": "PAY_PER_REQUEST",
  "KeySchema": [
    {
      "AttributeName": "InstanceID",
      "KeyType": "HASH"
    },
    {
      "AttributeName": "Timestamp",
      "KeyType": "RANGE"
    }
  ],
  "AttributeDefinitions": [
    {
      "AttributeName": "InstanceID",
      "AttributeType": "S"
    },
    {
      "AttributeName": "Timestamp",
      "AttributeType": "S"
    }
  ],
  "TimeToLiveSpecification": {
    "Enabled": true,
    "AttributeName": "ExpireAt"
  },
  "SampleItems": [
    {
